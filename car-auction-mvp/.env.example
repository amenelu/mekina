# APP_ENV can be development, staging, or production.
APP_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5001

# Required in staging and production.
SECRET_KEY=change-me
# Use an absolute SQLite path on staging/production persistent disk.
# Later PostgreSQL switch: postgresql+psycopg2://user:password@host:5432/database
DATABASE_URL=sqlite:///database.db
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional backend settings.
JWT_EXPIRATION_DAYS=30
MAX_CONTENT_LENGTH=16777216
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Required when exporting the Expo web bundle.
EXPO_PUBLIC_API_URL=http://localhost:5001
EXPO_PUBLIC_SOCKET_URL=http://localhost:5001
